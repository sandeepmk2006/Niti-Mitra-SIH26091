# EAS ignore file — controls what goes into the build archive.
#
# IMPORTANT: when .easignore exists it REPLACES .gitignore for the upload, it
# does not add to it. So everything that must stay out of the archive has to be
# listed here explicitly, including node_modules.

# Dependencies — EAS installs these on the build server from package-lock.json
node_modules/

# Git history (488 MB: an early commit contains the original model blob)
.git/

# Superseded original weights (Q5_K_M, 379 MiB). The requantized Q4_0 copy in
# assets/models/ is the one that ships, so this stays out of the build archive.
assest/

# Native projects — regenerated by prebuild on the build server
android/
ios/

# Expo local state
.expo/
dist/

# Docs
docs/

# Firebase local files
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore.rules
firebase.json
.firebaserc

# Python backend (not part of the RN build)
functions/

# Legacy on-device model weights — no longer used by the app
assets/models/
